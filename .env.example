# ---- matching (optional LLM and embeddings) ----
# none | openai | gemini | anthropic
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# auto | minilm | tfidf
EMBEDDINGS=auto

# ---- accounts and security ----
# Set to 1 when the app is served over HTTPS (it makes the cookie Secure and turns on HSTS).
COOKIE_SECURE=0
# Longest a sign-in lasts, and how long without use before signing out.
SESSION_HOURS=12
SESSION_IDLE_HOURS=2
# Salt for the candidate codes employers see. Make it long and random, and never change it
# (changing it changes every code). Required when COOKIE_SECURE=1. Try: openssl rand -hex 32
CANDIDATE_SALT=
# Only on the first start, when there are no accounts. Remove both lines after the first sign-in.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Set to 1 only when a reverse proxy you control sets X-Forwarded-For.
TRUST_PROXY=0
# 1 = the sign-in page offers a drop down of every user and needs no password. For demos on a
# private machine only. The app refuses to start with this and COOKIE_SECURE=1 together.
DEMO_LOGIN=0
# Used only by "python -m matcher.accounts seed-demo". Never used in secure mode.
DEMO_PASSWORD=
# Compose test startup options. Keep these at 0 for a real deployment.
RUN_PIPELINE=1
SEED_DEMO=1
SEED_OUTCOMES=1

# ---- links in emails and WhatsApp messages ----
# Where people open the app. Links in messages point here.
APP_URL=http://localhost:5173
# Where the API is reached from outside, if not the same as APP_URL (used for the Google sign-in return address).
API_URL=
TIMEZONE=Asia/Kolkata
# 1 = send emails and WhatsApp messages inside the request instead of in the background (tests only).
OUTBOX_SYNC=0

# ---- email (any SMTP server; a Gmail app password works) ----
# Without SMTP_HOST every email is a dry run you can read in Settings, Sent messages.
SMTP_HOST=
SMTP_PORT=587
# 1 = SSL from the start (usually port 465). 0 = STARTTLS (usually port 587).
SMTP_SSL=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- WhatsApp (Meta Cloud API) ----
# Without WHATSAPP_TOKEN every WhatsApp message is a dry run.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
# Meta checks the webhook with this token, and signs every call with the app secret.
# Required together with WHATSAPP_TOKEN when COOKIE_SECURE=1.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional extra hold: the only numbers that may get a message (comma-separated). For testing, use the stand-ins below.
WHATSAPP_ONLY_TO=
# Approved template names, if yours differ (see README, "WhatsApp templates").
WHATSAPP_TEMPLATE_OPPORTUNITY=new_opportunity
WHATSAPP_TEMPLATE_MATCHES=matches_ready
WHATSAPP_TEMPLATE_UPDATE=ngo_update
WHATSAPP_TEMPLATE_INTERVIEW=interview_scheduled

# ---- test stand-ins (optional, and removable) ----
# While the data is fake, real messages go to these people and to nobody else. The data itself is not changed.
# who=where, comma-separated. who is a student ID (S001), a username (admin, officer, gopuram), or * for everyone not named.
# For WhatsApp, * means every student. Only students get WhatsApp from the app. A phone under any other name (admin, lead)
# plays an employer writing in: its messages become leads, and it can be replied to.
# Example: STANDIN_WHATSAPP=*=91FRIENDSNUMBER,admin=91YOURNUMBER
#          STANDIN_EMAIL=*=friend@gmail.com,admin=you@gmail.com,officer=someone@gmail.com,gopuram=employer@gmail.com
# Delete both lines to go live. With live WhatsApp keys, the app will not start on the sample students without them.
STANDIN_WHATSAPP=
STANDIN_EMAIL=

# ---- Google Calendar and Meet (interview invites) ----
# A Google Cloud OAuth client (web application) with the Calendar API on. An admin then connects
# one NGO Google account in Settings. Without these, interviews get a calendar file by email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to API_URL (or APP_URL) + /api/integrations/google/callback. Add it to the OAuth client.
GOOGLE_REDIRECT_URI=

# ---- Fireflies.ai notetaker ----
# The bot joins interviews that ask for notes, and the summary comes back through the webhook.
FIREFLIES_API_KEY=
FIREFLIES_BOT_EMAIL=fred@fireflies.ai
# Required with FIREFLIES_API_KEY when COOKIE_SECURE=1.
FIREFLIES_WEBHOOK_SECRET=
